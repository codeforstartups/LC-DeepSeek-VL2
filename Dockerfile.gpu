# Use NVIDIA’s CUDA runtime as base so the container can access your GPU
FROM nvidia/cuda:12.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install Ollama CLI prerequisites
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      curl \
      ca-certificates \
      gnupg \
 && rm -rf /var/lib/apt/lists/*

# Install Ollama
RUN curl -fsSL https://ollama.com/install.sh | sh

# Pull the 1.5B version of DeepSeek-R1 at build time
RUN ollama pull deepseek-r1:1.5b

# Expose the default Ollama server port
EXPOSE 11434

# Launch Ollama’s HTTP server by default
ENTRYPOINT ["ollama", "serve"]
